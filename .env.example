# rosetta.fun — build-time public configuration (A8).
#
# Everything here is PUBLIC by design: it is compiled into the static bundle and
# visible to anyone who views source. That is fine and expected for Firebase Web
# config (it identifies the project; it does not authorize anything — security
# lives in Firebase rules and in mo-backend's token verification).
#
# NOTHING SECRET GOES IN THIS FILE. No Stripe secret key, no service account, no
# webhook signing secret. The site never mints a checkout session itself — it
# asks mo-backend to, with the user's own ID token (ROSETTA_ACCOUNTS.md A8
# hardening: "site never holds secrets").
#
# Copy to `.env` and fill in. An absent/incomplete config is NOT silently
# tolerated: /account renders a loud "not configured" state rather than a broken
# sign-in button (the same reject-by-default-but-observably rule the backend
# follows).

# --- Firebase Web app (owner step: Firebase console → Project settings → Your
# apps → Add app → Web. This registers a *web* app in the existing `mo-rosetta`
# project; it does not create a second project, and the uid space is shared with
# iOS — that shared uid is the whole point of A8.) -----------------------------
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=mo-rosetta.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=mo-rosetta
PUBLIC_FIREBASE_APP_ID=
# (optional — Auth does not use it; fill it in when a web app is registered)

# --- Backend --------------------------------------------------------------
# The same deployment the iOS app calls. Override for a local `uvicorn` run:
#   PUBLIC_MO_BASE_URL=http://127.0.0.1:8000
PUBLIC_MO_BASE_URL=https://tahar-immouni--main-fastapi-app.modal.run

# --- Sign-in methods offered on the web -----------------------------------
# Comma-separated subset of: apple,google,twitter,facebook,password
# Mirrors the app's `supportedMethods` seam so a provider trim (decision D1) is
# one env change in both places, not a code edit.
PUBLIC_AUTH_METHODS=apple,google,twitter,facebook,password

# --- Purchasable prices ----------------------------------------------------
# JSON array of {id,label,blurb,price} — `id` is the Stripe price id, and it
# must also appear in the backend's MO_STRIPE_PRICES map or checkout 400s.
#
# DELIBERATELY EMPTY BY DEFAULT (decision D3): no user-visible prices until the
# owner signs off on numbers with A5's real cost data. Empty ⇒ /account and
# /pricing both render "coming soon" instead of a buy button. The checkout code
# path is complete and tested either way — only the catalog is withheld.
#
# Example once signed off:
#   PUBLIC_STRIPE_PRICES=[{"id":"price_123","label":"10 songs","blurb":"One-time pack","price":"$4.99"}]
PUBLIC_STRIPE_PRICES=[]
